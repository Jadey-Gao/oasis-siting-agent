{
  "permissions": {
    "allow": [
      "Bash(python -m siting.cli:*)",
      "Bash(python -c:*)",
      "Bash(python:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Read(*)",
      "Write(runs/**)",
      "Write(decisions/**)",
      "Write(overrides/**)",
      "Write(harness/logs/**)",
      "Write(memory/**)",
      "Write(DECISIONS.md)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(curl * -o /*)",
      "Write(siting/**)",
      "Write(handbooks/**)",
      "Write(skills/**)",
      "Write(settings.json)",
      "Edit(siting/**)",
      "Edit(handbooks/**)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/hooks/pre_tool_use.sh \"$CLAUDE_TOOL_INPUT\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/hooks/post_tool_use.sh \"$CLAUDE_TOOL_INPUT\" \"$CLAUDE_TOOL_RESPONSE\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/hooks/post_tool_use.sh \"$CLAUDE_TOOL_INPUT\" \"$CLAUDE_TOOL_RESPONSE\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash harness/hooks/stop_hook.sh"
          }
        ]
      }
    ]
  }
}
